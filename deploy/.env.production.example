# Copy this file to deploy/.env.production on the deployment host.
# Do not commit the copied file or place credentials in this template.

# Container ports bound to localhost; expose them through a reverse proxy.
API_PORT=8080
WEB_PORT=8081

# SQL Server connection used by ASP.NET Core.
ConnectionStrings__DefaultConnection=Server=sql.example.com,1433;Database=BluePrintHr;User Id=blueprint_hr_app;Password=REPLACE_ME;TrustServerCertificate=True;MultipleActiveResultSets=True
Database__UseInMemory=false
Database__ApplyMigrations=true

# The public React origin allowed to send credentialed API requests.
Cors__AllowedOrigins__0=https://app.example.com

# HTTPS is required when the API and frontend are on separate secure origins.
Auth__CookieSameSite=None
Auth__RequireHttps=true

# SSRS base URL; credentials stay outside the browser.
Ssrs__ReportServerUrl=https://reports.example.com/ReportServer
