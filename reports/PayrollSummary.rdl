<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="BluePrintHRDataSource">
      <DataSourceReference>/BluePrintHR/BluePrintHRDataSource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <ReportParameters>
    <ReportParameter Name="TenantId"><DataType>Integer</DataType><Prompt>Tenant ID</Prompt></ReportParameter>
    <ReportParameter Name="PayrollPeriodId"><DataType>Integer</DataType><Prompt>Payroll Period ID</Prompt></ReportParameter>
  </ReportParameters>
  <DataSets>
    <DataSet Name="PayrollSummary">
      <Query>
        <DataSourceName>BluePrintHRDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@TenantId"><Value>=Parameters!TenantId.Value</Value></QueryParameter>
          <QueryParameter Name="@PayrollPeriodId"><Value>=Parameters!PayrollPeriodId.Value</Value></QueryParameter>
        </QueryParameters>
        <CommandText>SELECT e.EmployeeNo, CONCAT(e.FirstName, ' ', e.LastName) AS EmployeeName, e.KraPin, p.GrossPay, p.Paye, p.Nssf, p.Shif, p.HousingLevy, p.TotalDeductions, p.NetPay, p.Status FROM PayrollTransactions p INNER JOIN Employees e ON e.Id = p.EmployeeId WHERE p.TenantId = @TenantId AND p.PayrollPeriodId = @PayrollPeriodId ORDER BY e.FirstName, e.LastName;</CommandText>
      </Query>
      <Fields>
        <Field Name="EmployeeNo"><DataField>EmployeeNo</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="EmployeeName"><DataField>EmployeeName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="KraPin"><DataField>KraPin</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="GrossPay"><DataField>GrossPay</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Paye"><DataField>Paye</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Nssf"><DataField>Nssf</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Shif"><DataField>Shif</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="HousingLevy"><DataField>HousingLevy</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="TotalDeductions"><DataField>TotalDeductions</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="NetPay"><DataField>NetPay</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Status"><DataField>Status</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <Body>
    <ReportItems>
      <Textbox Name="Title"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>BluePrint HR — Payroll Summary</Value><Style><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><Color>#173A68</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Height>0.4in</Height><Width>10.2in</Width></Textbox>
      <Tablix Name="PayrollTable"><TablixBody><TablixColumns><TablixColumn><Width>1.1in</Width></TablixColumn><TablixColumn><Width>1.7in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.1in</Width></TablixColumn><TablixColumn><Width>1.1in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.3in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.28in</Height><TablixCells><TablixCell><CellContents><Textbox Name="h1"><Value>Employee No.</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h2"><Value>Employee</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h3"><Value>Gross Pay</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h4"><Value>PAYE</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h5"><Value>NSSF</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h6"><Value>SHIF</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h7"><Value>Net Pay</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h8"><Value>Status</Value></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="d1"><Value>=Fields!EmployeeNo.Value</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d2"><Value>=Fields!EmployeeName.Value</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d3"><Value>=FormatCurrency(Fields!GrossPay.Value, 2)</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d4"><Value>=FormatCurrency(Fields!Paye.Value, 2)</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d5"><Value>=FormatCurrency(Fields!Nssf.Value, 2)</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d6"><Value>=FormatCurrency(Fields!Shif.Value, 2)</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d7"><Value>=FormatCurrency(Fields!NetPay.Value, 2)</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d8"><Value>=Fields!Status.Value</Value></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage><KeepTogether>true</KeepTogether></TablixMember><TablixMember><Group Name="Details" /></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>PayrollSummary</DataSetName></Tablix>
    </ReportItems>
    <Height>5in</Height>
  </Body>
  <Width>10.2in</Width>
  <Page>
    <PageHeight>8.27in</PageHeight><PageWidth>11.69in</PageWidth><LeftMargin>0.5in</LeftMargin><RightMargin>0.5in</RightMargin><TopMargin>0.5in</TopMargin><BottomMargin>0.5in</BottomMargin>
  </Page>
</Report>
