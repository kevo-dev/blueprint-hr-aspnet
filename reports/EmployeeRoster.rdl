<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="BluePrintHRDataSource">
      <DataSourceReference>/BluePrintHR/BluePrintHRDataSource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <ReportParameters>
    <ReportParameter Name="TenantId"><DataType>Integer</DataType><Prompt>Tenant ID</Prompt></ReportParameter>
    <ReportParameter Name="EmploymentStatus"><DataType>String</DataType><Prompt>Employment status</Prompt><DefaultValues><DataSetReference><DataSetName>Statuses</DataSetName><ValueField>Status</ValueField></DataSetReference></DefaultValues></ReportParameter>
  </ReportParameters>
  <DataSets>
    <DataSet Name="Statuses"><Query><DataSourceName>BluePrintHRDataSource</DataSourceName><CommandText>SELECT 'Active' AS Status UNION ALL SELECT 'Inactive' AS Status UNION ALL SELECT 'On Leave' AS Status;</CommandText></Query><Fields><Field Name="Status"><DataField>Status</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet>
    <DataSet Name="EmployeeRoster">
      <Query><DataSourceName>BluePrintHRDataSource</DataSourceName><QueryParameters><QueryParameter Name="@TenantId"><Value>=Parameters!TenantId.Value</Value></QueryParameter><QueryParameter Name="@EmploymentStatus"><Value>=Parameters!EmploymentStatus.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT e.EmployeeNo, e.PayrollNo, CONCAT(e.FirstName, ' ', e.LastName) AS EmployeeName, e.KraPin, e.NssfNo, e.ShifNo, e.Email, e.Phone, e.EmploymentStatus, e.BasicSalary, b.Name AS BranchName, d.Name AS DepartmentName FROM Employees e LEFT JOIN Branches b ON b.Id = e.BranchId LEFT JOIN Departments d ON d.Id = e.DepartmentId WHERE e.TenantId = @TenantId AND e.EmploymentStatus = @EmploymentStatus ORDER BY e.FirstName, e.LastName;</CommandText></Query>
      <Fields><Field Name="EmployeeNo"><DataField>EmployeeNo</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PayrollNo"><DataField>PayrollNo</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="EmployeeName"><DataField>EmployeeName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="KraPin"><DataField>KraPin</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="NssfNo"><DataField>NssfNo</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ShifNo"><DataField>ShifNo</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Email"><DataField>Email</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Phone"><DataField>Phone</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="EmploymentStatus"><DataField>EmploymentStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BasicSalary"><DataField>BasicSalary</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="BranchName"><DataField>BranchName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DepartmentName"><DataField>DepartmentName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields>
    </DataSet>
  </DataSets>
  <Body>
    <ReportItems>
      <Textbox Name="Title"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>BluePrint HR — Employee Roster</Value><Style><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><Color>#173A68</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Height>0.4in</Height><Width>10.2in</Width></Textbox>
      <Tablix Name="EmployeeTable"><TablixBody><TablixColumns><TablixColumn><Width>1.1in</Width></TablixColumn><TablixColumn><Width>1.8in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.5in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.28in</Height><TablixCells><TablixCell><CellContents><Textbox Name="eh1"><Value>Employee No.</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="eh2"><Value>Employee</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="eh3"><Value>KRA PIN</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="eh4"><Value>NSSF / SHIF</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="eh5"><Value>Status</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="eh6"><Value>Department</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="eh7"><Value>Basic Salary</Value></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="ed1"><Value>=Fields!EmployeeNo.Value</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ed2"><Value>=Fields!EmployeeName.Value</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ed3"><Value>=Fields!KraPin.Value</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ed4"><Value>=Fields!NssfNo.Value &amp; " / " &amp; Fields!ShifNo.Value</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ed5"><Value>=Fields!EmploymentStatus.Value</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ed6"><Value>=Fields!DepartmentName.Value</Value></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ed7"><Value>=FormatCurrency(Fields!BasicSalary.Value, 2)</Value></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember><TablixMember><Group Name="Details" /></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>EmployeeRoster</DataSetName></Tablix>
    </ReportItems>
    <Height>5in</Height>
  </Body>
  <Width>10.2in</Width>
  <Page><PageHeight>8.27in</PageHeight><PageWidth>11.69in</PageWidth><LeftMargin>0.5in</LeftMargin><RightMargin>0.5in</RightMargin><TopMargin>0.5in</TopMargin><BottomMargin>0.5in</BottomMargin></Page>
</Report>
